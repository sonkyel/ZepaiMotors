# Copia este archivo como ".env.local" y rellena los valores.
# NO subas .env.local al repositorio (ya está ignorado en .gitignore).

# --- Guardar leads en Google Sheets (directo, con Apps Script) ---
# URL del Web App de Google Apps Script (ver GUARDAR-LEADS-SHEET.md).
SHEETS_WEBAPP_URL=
# Token secreto compartido: debe ser EXACTAMENTE el mismo que pusiste en el script.
SHEETS_TOKEN=

# --- Opcional: llamada de Retell.ai vía n8n (ver INTEGRACION-LEADS.md) ---
# URL del webhook de n8n. Si lo dejas vacío, no se dispara la llamada.
N8N_WEBHOOK_URL=

# --- Opcional: correo por Resend cuando llega un lead (ver ENVIAR-CORREO-LEADS.md) ---
# API key de Resend (empieza con "re_").
RESEND_API_KEY=
# A quién le llega el aviso. Si lo dejas vacío, usa info@zepaiagency.com por defecto.
RESEND_TO_EMAIL=
# Remitente. Sin dominio verificado en Resend, debe quedar tal cual (onboarding@resend.dev).
RESEND_FROM=
# Opcional: ID de un template publicado en resend.com/templates. Si lo dejas
# vacío, se envía un correo HTML simple generado en el código (igual de funcional).
RESEND_TEMPLATE_ID=
